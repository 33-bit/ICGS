# Optional user-local W&B settings for ICGS CLI commands. Copy to .env and add
# values locally; never commit the resulting file.
ICGS_WANDB_ENABLED=true
ICGS_WANDB_MODE=online
ICGS_WANDB_PROJECT=icgs
ICGS_WANDB_ENTITY=icgs

# Credentials are read by the coordinator or explicit CLI integrations only.
# Workers must receive neither values nor environment variables.
# HF_TOKEN=replace-with-your-token
# HF_ACCESS_TOKEN=replace-with-your-token
# HUGGINGFACE_HUB_TOKEN=replace-with-your-token
# WANDB_API_KEY=replace-with-your-key
# ICGS_HF_TOKEN_PATH=/secure/credentials/hf-token
